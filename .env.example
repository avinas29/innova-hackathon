# ─────────────────────────────────────────────────────────────────────────────
# VERITAS configuration
#
# The system runs with ZERO keys set (offline deterministic providers), which is
# how the test suite and CI exercise the full graph. For real research you need
# at minimum ONE model provider key. Search falls back to keyless DuckDuckGo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Model providers (at least one recommended) ───────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free key from https://console.groq.com/keys — no credit card, and by far
# the most generous free tier: 14,400 requests/day and sub-second latency.
# Preferred over Gemini when both are set.
GROQ_API_KEY=
# Free key from https://aistudio.google.com/apikey — no credit card required.
GEMINI_API_KEY=

# Which provider to prefer: openai | anthropic | groq | gemini | auto | fake
# `auto` picks the first key present, in that order.
VERITAS_LLM_PROVIDER=auto

# Model roles. Cheap model does extraction/classification (high volume),
# strong model does adjudication and synthesis (low volume, high stakes).
VERITAS_MODEL_FAST=gpt-4.1-mini
VERITAS_MODEL_STRONG=gpt-4.1
VERITAS_MODEL_FAST_ANTHROPIC=claude-haiku-4-5-20251001
VERITAS_MODEL_STRONG_ANTHROPIC=claude-sonnet-5
# Flash-Lite has the largest free quota (15 RPM / 1000 per day) and absorbs the
# high-volume calls. These defaults were picked by measuring latency on a live
# free key: gemini-3.1-flash-lite answers in ~0.8s, while gemini-3.5-flash-lite
# took 12-66s and is not viable at this call volume. The 2.5 family returns 404
# for keys issued after its retirement.
VERITAS_MODEL_FAST_GEMINI=gemini-3.1-flash-lite
VERITAS_MODEL_STRONG_GEMINI=gemini-3.5-flash
VERITAS_EMBEDDING_MODEL=text-embedding-3-small
VERITAS_EMBEDDING_MODEL_GEMINI=gemini-embedding-2
# Groq models, chosen by measuring a live free key: 8b-instant is fastest
# (0.3s, 14,400 req/day) for high-volume calls; 70b-versatile has the
# largest token budget (12,000 TPM) and best quality for adjudication.
VERITAS_MODEL_FAST_GROQ=llama-3.3-70b-versatile
VERITAS_MODEL_STRONG_GROQ=openai/gpt-oss-120b

# ── Quota profile ────────────────────────────────────────────────────────────
# `free` shrinks the workload to fit a free-tier daily allowance: fewer research
# questions, fewer claims, no self-consistency resampling. Set this if you are
# using a free Gemini key.
VERITAS_PROFILE=default

# Client-side pacing. Leave at 0 to auto-apply Gemini's published free-tier
# quota; set explicitly to override (e.g. after upgrading to a paid tier).
VERITAS_RPM_LIMIT=0
VERITAS_DAILY_LIMIT=0

# ── Search providers (optional — DuckDuckGo needs no key) ────────────────────
# Self-hosted SearXNG: no key, no quota, aggregates many engines. Best option.
# Start one with:  docker compose --profile searxng up -d searxng
# Requires `formats: [json]` under `search:` in its settings.yml.
SEARXNG_URL=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
# Comma-separated priority order. Unconfigured providers are skipped silently.
VERITAS_SEARCH_ORDER=searxng,tavily,exa,brave,duckduckgo
# Hard network kill-switch — no outbound retrieval at all. Used by the test suite.
VERITAS_OFFLINE=false

# ── Budgets (hard ceilings, enforced in graph state) ─────────────────────────
VERITAS_MAX_TOKENS_PER_RUN=400000
VERITAS_MAX_WALL_SECONDS=900
VERITAS_MAX_RESEARCH_QUESTIONS=6
VERITAS_MAX_CLAIMS=40
VERITAS_MAX_EVIDENCE_PER_CLAIM=8
VERITAS_MAX_REFLECTION_LOOPS=2
VERITAS_VERIFY_CONCURRENCY=8

# ── Verification tuning ──────────────────────────────────────────────────────
# llm | local  (local requires the `local-nli` extra)
VERITAS_ENTAILMENT_BACKEND=llm
VERITAS_LOCAL_NLI_MODEL=lytang/MiniCheck-Flan-T5-Large
# Cosine threshold above which two evidence snippets are one cluster.
VERITAS_DEDUP_THRESHOLD=0.86
# Samples for the self-consistency confidence feature.
VERITAS_CONSISTENCY_SAMPLES=3

# ── Storage ──────────────────────────────────────────────────────────────────
VERITAS_DB_PATH=./veritas.db
VERITAS_CACHE_ENABLED=true
VERITAS_CACHE_TTL_SECONDS=604800

# ── Observability ────────────────────────────────────────────────────────────
VERITAS_LOG_LEVEL=INFO
VERITAS_LOG_JSON=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── API ──────────────────────────────────────────────────────────────────────
VERITAS_CORS_ORIGINS=http://localhost:3000
# DEV ONLY. Used when the UI runs on :3000 via `make web` and the API on :8000.
# Leave EMPTY for any deployment: the container serves UI and API from one
# origin, so relative requests are correct. A localhost value shipped to
# production tells every visitor's browser to call their own machine.
NEXT_PUBLIC_API_URL=
